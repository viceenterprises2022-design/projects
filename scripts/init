#!/usr/bin/env bash
DIR="/home/vreddy1/Desktop/Projects/scripts"
# Choose terminal launcher
if command -v x-terminal-emulator >/dev/null 2>&1; then
    LAUNCH="x-terminal-emulator -e"
elif command -v gnome-terminal >/dev/null 2>&1; then
    LAUNCH="gnome-terminal --working-directory=$DIR --"
elif command -v konsole >/dev/null 2>&1; then
    LAUNCH="konsole --workdir=$DIR -e"
elif command -v xfce4-terminal >/dev/null 2>&1; then
    LAUNCH="xfce4-terminal --working-directory=$DIR --"
elif command -v lxterminal >/dev/null 2>&1; then
    LAUNCH="lxterminal --working-directory=$DIR -e"
elif command -v mate-terminal >/dev/null 2>&1; then
    LAUNCH="mate-terminal --working-directory=$DIR -e"
elif command -v alacritty >/dev/null 2>&1; then
    LAUNCH="alacritty --working-directory=$DIR -e"
elif command -v kitty >/dev/null 2>&1; then
    LAUNCH="kitty --directory=$DIR"
else
    echo "No supported terminal emulator found. Please install gnome-terminal or another."
    exit 1
fi

echo "Select an agent to launch:"
options=("Hermes" "Antigravity" "Opencode" "oh-my-pie" "goose" "freebuff" "kimchi" "Claude" "Codex")
select opt in "${options[@]}"; do
    case $opt in
        "Hermes")
            $LAUNCH bash -c "cd $DIR && hermes; exec bash"
            break
            ;;
        "Antigravity")
            $LAUNCH bash -c "cd $DIR && agy; exec bash"
            break
            ;;
        "Opencode")
            $LAUNCH bash -c "cd $DIR && opencode; exec bash"
            break
            ;;
        "oh-my-pie")
            $LAUNCH bash -c "cd $DIR && omp; exec bash"
            break
            ;;
        "goose")
            $LAUNCH bash -c "cd $DIR && goose; exec bash"
            break
            ;;
        "freebuff")
            $LAUNCH bash -c "cd $DIR && freebuff; exec bash"
            break
            ;;
        "kimchi")
            $LAUNCH bash -c "cd $DIR && kimchi; exec bash"
            break
            ;;
        "Claude")
            $LAUNCH bash -c "cd $DIR && claude; exec bash"
            break
            ;;
        "Codex")
            $LAUNCH bash -c "cd $DIR && codex; exec bash"
            break
            ;;
        *) echo "Invalid option $REPLY";;
    esac
done