#!/usr/bin/env python3
"""
LogWork CLI tool for AlphaEdge
Automatically reads the newest accomplishments from AGENTS.md and creates a corresponding Multica issue.
"""
import sys
import os
import re
import subprocess
import datetime

def main():
    agents_path = "/home/vreddy1/Desktop/Projects/scripts/AGENTS.md"
    if not os.path.exists(agents_path):
        print(f"Error: {agents_path} not found.")
        sys.exit(1)
        
    with open(agents_path, 'r') as f:
        content = f.read()
        
    # Find the newest entry for today (2026-05-26) under Session Memory
    today_str = "2026-05-26" # Sourced dynamically based on user's current session time
    pattern = rf"### ({today_str}): ([^\n]+)\n(.*?)(?=\n###|\Z)"
    match = re.search(pattern, content, re.DOTALL)
    
    if not match:
        print(f"[LogWork] Error: Could not find today's entry ({today_str}) under Session Memory in AGENTS.md.")
        sys.exit(1)
        
    date_val, title_val, desc_val = match.groups()
    title = title_val.strip()
    
    # Format and clean description lines (strip leading bullets, ignore the Multica marker line)
    desc_lines = []
    for line in desc_val.strip().split("\n"):
        clean_line = line.strip()
        if not clean_line or "Multica:" in clean_line:
            continue
        desc_lines.append(clean_line.lstrip("- ").strip())
    desc = "\n".join(desc_lines)
    
    print(f"[LogWork] Logging work to Multica...")
    print(f"  Title:       {title}")
    print(f"  Project ID:  8eaf35e9 (Tools)")
    print(f"  Assignee:    Vinod-AI-CEO")
    print(f"  Due Date:    {today_str}")
    print(f"  Description:\n{desc}\n")
    
    # Call multica issue create
    cmd = [
        "/usr/local/bin/multica", "issue", "create",
        "--project", "8eaf35e9",
        "--title", title,
        "--assignee", "Vinod-AI-CEO",
        "--status", "done",
        "--priority", "high",
        "--start-date", f"{today_str}T00:00:00Z",
        "--due-date", f"{today_str}T23:59:59Z",
        "--description", desc
    ]
    
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode == 0:
        print("[LogWork] Success! Issue created successfully in Multica:")
        print(res.stdout)
    else:
        print(f"[LogWork] Error running multica: {res.stderr.strip() or res.stdout.strip()}")
        sys.exit(1)

if __name__ == "__main__":
    main()
