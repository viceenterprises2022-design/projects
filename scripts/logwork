#!/usr/bin/env python3
"""
LogWork CLI tool for AlphaEdge
Automatically reads today's accomplishments from AGENTS.md, checks existing Multica issues,
and logs any unlogged entries to Multica.
"""
import sys
import os
import re
import json
import subprocess
import datetime

def main():
    agents_path = "/home/vreddy1/Desktop/Projects/scripts/AGENTS.md"
    if not os.path.exists(agents_path):
        print(f"Error: {agents_path} not found.")
        sys.exit(1)
        
    with open(agents_path, 'r') as f:
        content = f.read()
        
    # 1. Fetch current issues from Multica to deduplicate by title
    print("[LogWork] Fetching existing issues from Multica...")
    list_cmd = ["/usr/local/bin/multica", "issue", "list", "--output", "json", "--limit", "1000"]
    res = subprocess.run(list_cmd, capture_output=True, text=True)
    
    existing_titles = set()
    if res.returncode == 0:
        try:
            data = json.loads(res.stdout)
            issues_list = []
            if isinstance(data, list):
                issues_list = data
            elif isinstance(data, dict) and "issues" in data:
                issues_list = data["issues"]
            for issue in issues_list:
                if isinstance(issue, dict) and "title" in issue:
                    existing_titles.add(issue["title"].strip().lower())
        except Exception as e:
            print(f"[LogWork] Warning: Failed to parse existing issue list ({e}). Continuing without deduplication.")
    else:
        print("[LogWork] Warning: Could not reach Multica workspace. Continuing without deduplication.")

    # 2. Find all entries for today under Session Memory
    if len(sys.argv) > 1:
        today_str = sys.argv[1]
    else:
        today_str = datetime.date.today().strftime("%Y-%m-%d")
        
    # Find all matches for "### YYYY-MM-DD: Title" and capture content until next h3/###
    pattern = rf"### ({today_str}): ([^\n]+)\n(.*?)(?=\n###|\Z)"
    matches = re.findall(pattern, content, re.DOTALL)
    
    if not matches:
        print(f"[LogWork] Error: No entries for today ({today_str}) found in AGENTS.md under Session Memory.")
        sys.exit(1)
        
    logged_count = 0
    for date_val, title_val, desc_val in matches:
        title = title_val.strip()
        title_lower = title.lower()
        
        # Check if already logged
        if title_lower in existing_titles:
            print(f"[LogWork] Skipping: '{title}' is already logged in Multica.")
            continue
            
        # Format and clean description lines
        desc_lines = []
        for line in desc_val.strip().split("\n"):
            clean_line = line.strip()
            if not clean_line or "Multica:" in clean_line:
                continue
            desc_lines.append(clean_line.lstrip("- ").strip())
        desc = "\n".join(desc_lines)
        
        print(f"\n[LogWork] Logging new work entry to Multica:")
        print(f"  Title:       {title}")
        print(f"  Project ID:  8eaf35e9 (Tools)")
        print(f"  Assignee:    Vinod-AI-CEO")
        print(f"  Due Date:    {today_str}")
        print(f"  Description:\n{desc}\n")
        
        # Call multica issue create
        cmd = [
            "/usr/local/bin/multica", "issue", "create",
            "--project", "8eaf35e9",
            "--title", title,
            "--assignee", "Vinod-AI-CEO",
            "--status", "done",
            "--priority", "high",
            "--start-date", f"{today_str}T00:00:00Z",
            "--due-date", f"{today_str}T23:59:59Z",
            "--description", desc
        ]
        
        create_res = subprocess.run(cmd, capture_output=True, text=True)
        if create_res.returncode == 0:
            print(f"[LogWork] Success! Issue created successfully in Multica:")
            print(create_res.stdout)
            logged_count += 1
        else:
            print(f"[LogWork] Error logging issue '{title}': {create_res.stderr.strip() or create_res.stdout.strip()}")
            
    if logged_count == 0:
        print("\n[LogWork] All today's entries are already logged in Multica. Workspace is fully up-to-date!")

if __name__ == "__main__":
    main()
