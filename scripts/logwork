#!/usr/bin/env python3
"""
LogWork CLI tool for AlphaEdge
Reads today's "Session Memory" entries from scripts/AGENTS.md, dedupes against
existing Multica issues by title, creates new issues, and posts a Block Kit
summary to Slack via the shared send_slack.py helper.

Usage:
  logwork                 # today (host clock)
  logwork YYYY-MM-DD      # specific date
  logwork --no-slack      # skip Slack summary
"""
import sys
import os
import re
import json
import subprocess
import datetime
from pathlib import Path

# Make sibling send_slack importable when invoked from anywhere
SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

try:
    from send_slack import send_to_slack, compose_blocks  # type: ignore
    from dotenv import load_dotenv  # type: ignore
    load_dotenv(SCRIPT_DIR / ".env")
except Exception as _e:
    send_to_slack = None
    compose_blocks = None


AGENTS_PATH = SCRIPT_DIR / "AGENTS.md"
CHANGELOG_PATH = SCRIPT_DIR / "CHANGELOG.md"
MULTICA_BIN = "/usr/local/bin/multica"
PROJECT_ID = "8eaf35e9"  # Tools
ASSIGNEE = "Vinod-AI-CEO"


def archive_to_changelog(day: str, archived: list[tuple[str, str]]) -> int:
    """Append archived entries to CHANGELOG.md (newest first within the day group).
    Returns number of entries written. Creates the file if missing."""
    if not archived:
        return 0
    header = CHANGELOG_PATH.read_text() if CHANGELOG_PATH.exists() else "# Changelog\n\nDated history of work. Auto-populated by `/logwork --prune`.\n\n"
    block = []
    for title, desc in archived:
        block.append(f"### {day}: {title}")
        if desc.strip():
            block.append(desc.strip())
        block.append("- **Multica:** logged via `/logwork` on " + day)
        block.append("")
    new = header.rstrip() + "\n\n" + "\n".join(block).rstrip() + "\n"
    CHANGELOG_PATH.write_text(new)
    return len(archived)


def prune_from_agents(day: str, titles_to_remove: list[str]) -> int:
    """Remove `### {day}: {title}` blocks from AGENTS.md whose title matches.
    Match is case-insensitive on the title. Returns count removed."""
    if not titles_to_remove or not AGENTS_PATH.exists():
        return 0
    content = AGENTS_PATH.read_text()
    removed = 0
    wanted = {t.lower() for t in titles_to_remove}
    # Match a full block starting at "### YYYY-MM-DD: ..." until the next "### " or end-of-file
    pattern = rf"### ({re.escape(day)}): ([^\n]+)\n(.*?)(?=\n### |\Z)"
    def repl(m: re.Match) -> str:
        nonlocal removed
        title = m.group(2).strip().lower()
        if title in wanted:
            removed += 1
            return ""  # drop the whole block
        return m.group(0)
    new = re.sub(pattern, repl, content, flags=re.DOTALL)
    # Tidy: collapse runs of 3+ blank lines down to 2
    new = re.sub(r"\n{3,}", "\n\n", new)
    AGENTS_PATH.write_text(new)
    return removed


def fetch_existing_titles():
    res = subprocess.run(
        [MULTICA_BIN, "issue", "list", "--output", "json", "--limit", "1000"],
        capture_output=True, text=True,
    )
    titles = set()
    if res.returncode != 0:
        print("[LogWork] Warning: Could not reach Multica. Continuing without dedup.")
        return titles
    try:
        data = json.loads(res.stdout)
        issues = data if isinstance(data, list) else data.get("issues", [])
        for issue in issues:
            if isinstance(issue, dict) and "title" in issue:
                titles.add(issue["title"].strip().lower())
    except Exception as e:
        print(f"[LogWork] Warning: parse failed ({e}). No dedup.")
    return titles


def parse_entries(content, day):
    pattern = rf"### ({re.escape(day)}): ([^\n]+)\n(.*?)(?=\n###|\Z)"
    return re.findall(pattern, content, re.DOTALL)


def clean_description(raw):
    out = []
    for line in raw.strip().split("\n"):
        s = line.strip()
        if not s or "Multica:" in s:
            continue
        out.append(s.lstrip("- ").strip())
    return "\n".join(out)


def create_issue(title, desc, day):
    cmd = [
        MULTICA_BIN, "issue", "create",
        "--project", PROJECT_ID,
        "--title", title,
        "--assignee", ASSIGNEE,
        "--status", "done",
        "--priority", "high",
        "--start-date", day,
        "--due-date", day,
        "--description", desc,
    ]
    return subprocess.run(cmd, capture_output=True, text=True)


def post_slack(day, logged, skipped, failed):
    webhook = os.getenv("SLACK_WEBHOOK_MULTICA") or os.getenv("SLACK_WEBHOOK_URL")
    if not webhook or send_to_slack is None or compose_blocks is None:
        print("[LogWork] Slack skipped (no webhook or helper unavailable).")
        return
    total = len(logged) + len(skipped) + len(failed)
    color = "good"
    if failed:
        color = "danger"
    elif not logged:
        color = "info"

    def fmt_list(items):
        return "\n".join(f"• {t}" for t in items) if items else "_none_"

    body_parts = []
    if logged:
        body_parts.append(f"*Logged ({len(logged)}):*\n{fmt_list(logged)}")
    if skipped:
        body_parts.append(f"*Skipped — already present ({len(skipped)}):*\n{fmt_list(skipped)}")
    if failed:
        body_parts.append(f"*Failed ({len(failed)}):*\n" + "\n".join(f"• {t}: {e}" for t, e in failed))
    body = "\n\n".join(body_parts) or "_no entries found_"

    blocks = compose_blocks(
        header=f"LogWork — {day}",
        fields={
            "Date": day,
            "Logged": str(len(logged)),
            "Skipped": str(len(skipped)),
            "Failed": str(len(failed)),
        },
        body=body,
        context=[f"Project `{PROJECT_ID}` • Assignee `{ASSIGNEE}` • {total} entries scanned"],
    )
    res = send_to_slack(webhook, f"LogWork {day}: {len(logged)} new, {len(skipped)} dup, {len(failed)} fail", blocks=blocks, color=color)
    print(f"[LogWork] Slack: {res.get('ok')}")


def main():
    args = [a for a in sys.argv[1:] if a]
    no_slack = "--no-slack" in args
    prune = "--prune" in args
    args = [a for a in args if a not in ("--no-slack", "--prune")]
    day = args[0] if args else datetime.date.today().strftime("%Y-%m-%d")

    if not AGENTS_PATH.exists():
        print(f"Error: {AGENTS_PATH} not found.")
        sys.exit(1)
    content = AGENTS_PATH.read_text()

    print("[LogWork] Fetching existing issues from Multica...")
    existing = fetch_existing_titles()

    matches = parse_entries(content, day)
    if not matches:
        print(f"[LogWork] No entries for {day} found under Session Memory.")
        if not no_slack:
            post_slack(day, [], [], [])
        sys.exit(0)

    logged, skipped, failed = [], [], []
    archived_pairs: list[tuple[str, str]] = []
    for _, title_val, desc_val in matches:
        title = title_val.strip()
        if title.lower() in existing:
            print(f"[LogWork] Skip (dup): {title}")
            skipped.append(title)
            archived_pairs.append((title, desc_val))  # already in Multica → safe to archive on --prune
            continue
        desc = clean_description(desc_val)
        print(f"\n[LogWork] Creating: {title}")
        res = create_issue(title, desc, day)
        if res.returncode == 0:
            print(f"[LogWork] OK: {title}")
            logged.append(title)
            archived_pairs.append((title, desc_val))
        else:
            err = (res.stderr or res.stdout).strip().splitlines()[-1] if (res.stderr or res.stdout) else "unknown"
            print(f"[LogWork] FAIL: {title} -> {err}")
            failed.append((title, err))

    print(f"\n[LogWork] Summary: {len(logged)} logged, {len(skipped)} skipped, {len(failed)} failed.")

    archived_count = 0
    pruned_count = 0
    if prune and archived_pairs:
        archived_count = archive_to_changelog(day, archived_pairs)
        pruned_count = prune_from_agents(day, [t for t, _ in archived_pairs])
        print(f"[LogWork] Prune: archived {archived_count} entries to CHANGELOG.md, removed {pruned_count} from AGENTS.md.")

    # Automatically sync to Obsidian project folder
    print("\n[LogWork] Syncing project files to Obsidian vault...")
    try:
        extractor_script = SCRIPT_DIR / "scratch" / "extract_projects.py"
        if extractor_script.exists():
            res = subprocess.run([sys.executable, str(extractor_script)], capture_output=True, text=True)
            if res.returncode == 0:
                print("[LogWork] Obsidian project sync completed successfully.")
            else:
                print(f"[LogWork] Obsidian sync failed: {res.stderr or res.stdout}")
        else:
            print(f"[LogWork] Obsidian sync skipped (extractor script not found: {extractor_script})")
    except Exception as e:
        print(f"[LogWork] Error running Obsidian sync: {e}")

    if not no_slack:
        post_slack(day, logged, skipped, failed)


if __name__ == "__main__":
    main()

